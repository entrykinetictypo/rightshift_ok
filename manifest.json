{
  "manifest_version": 3,
  "name": "Entry Right Shift + Right Ctrl (virtual)",
  "version": "4.1.0",
  "description": "Adds virtual Right Shift (161) and Right Ctrl (163) for Entry blocks without changing normal Shift/Ctrl behavior.",
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/*",
        "https://*.playentry.org/*"
      ],
      "js": [
        "remap.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
