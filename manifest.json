{
  "manifest_version": 3,
  "name": "Entry Shift & Ctrl Both Sides",
  "version": "4.2.1",
  "description": "Makes existing Entry Shift/Ctrl blocks recognize either side, including /ws editors and eligible embedded frames.",
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/*",
        "https://*.playentry.org/*"
      ],
      "js": [
        "remap.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN",
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
