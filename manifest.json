{
  "manifest_version": 3,
  "name": "Entry Shift & Ctrl Both Sides",
  "version": "4.2.0",
  "description": "Makes Entry's existing Shift and Ctrl blocks recognize both left and right keys. No extra virtual key choices.",
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/*",
        "https://*.playentry.org/*"
      ],
      "js": [
        "remap.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
